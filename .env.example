# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Supabase (required for auth) ──────────────────────────────────────────────
# Find these in your Supabase project: Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── API server (required to run the Express backend) ──────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# DATABASE_URL is auto-provided by Replit.
# For local dev, set it to your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/beacon_trust
