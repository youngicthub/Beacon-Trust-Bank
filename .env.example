# ─────────────────────────────────────────────────────────────────────────────
# Beacon Trust — environment variable template
#
# Copy this file to .env and fill in your real values.
# .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: your Neon connection string (postgresql://...)
# On Replit:  leave unset — Replit injects DATABASE_URL automatically
# On Render:  set in the Render dashboard environment variables panel
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Supabase (auth) ───────────────────────────────────────────────────────────
# Find these at: Supabase dashboard → your project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PROJECT_ID=xxxxxxxxxxxxxxxxxxxx

# Vite needs the VITE_ prefix to expose vars to the browser bundle
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PROJECT_ID=xxxxxxxxxxxxxxxxxxxx

# ── API server ────────────────────────────────────────────────────────────────
PORT=3001
SESSION_SECRET=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-different-long-random-string

# ── Frontend → API URL ────────────────────────────────────────────────────────
# Local dev: leave blank — Vite proxies /api → http://localhost:3001 for you.
# Production build for cPanel: set to your Render API URL before running build:
#   VITE_API_URL=https://beacon-trust-api.onrender.com npm run build
VITE_API_URL=
